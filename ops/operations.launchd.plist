<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.pokemon-scalper-operations</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE_PATH__</string>
    <string>src/scalper/operations-cycle.mjs</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPOSITORY_PATH__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__REPOSITORY_PATH__/data/scalper/operations-launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__REPOSITORY_PATH__/data/scalper/operations-launchd.err.log</string>
</dict>
</plist>
