# Pokemon TCG Scalper — environment template.
# Copy to .env and fill in. Every variable is optional in paper mode;
# the ones marked LIVE are required when SCALPER_LIVE=1.

# ── Mode ──────────────────────────────────────────────────────────────
# 1 = real purchases (money leaves your account). Anything else = paper.
SCALPER_LIVE=0

# ── Discord signal ingestion ──────────────────────────────────────────
# Token issued to an authorized Discord bot application. Enable the Guilds,
# Guild Messages, and Message Content intents, and have a server administrator
# install the bot with access to the monitored channels. Do not extract a normal
# user session token from Chrome or use a token generator.
SCALPER_DISCORD_BOT_TOKEN=
# Local Discord routing file. Copy the sanitized example before enabling the
# feed; the real file is ignored because it identifies private servers,
# channels, and authors.
SCALPER_DISCORD_CONFIG_PATH=config/scalper-discord.json

# Optional: incoming webhook for alerts (separate from the bot token).
SCALPER_ALERT_WEBHOOK_URL=

# Minimum signal rank (0-100) before an alert is sent. 50 suppresses routine
# low-confidence Amazon/marketplace chatter while retaining priority products.
SCALPER_ALERT_MIN_RANK=50

# ── Safety limits (LIVE) ──────────────────────────────────────────────
# Max USD for a single order (unit price × quantity).
SCALPER_MAX_ORDER_USD=100

# Max USD spent across all orders in a UTC day.
SCALPER_MAX_DAILY_SPEND_USD=500

# Max units per order.
SCALPER_MAX_QUANTITY=1

# Set to 1 to hard-stop all live purchases (kill switch).
SCALPER_KILL_SWITCH=1

# Allow checkout when the product price is unknown (default: block).
SCALPER_ALLOW_UNKNOWN_PRICE=0

# Allow live checkout without fresh market evidence. Keep at 0 unless an
# operator explicitly accepts the missing profitability evidence.
SCALPER_ALLOW_UNSCORED=0

# Maximum age of market evidence accepted by the live profitability gate.
SCALPER_MARKET_MAX_AGE_MS=86400000

# ── TCGplayer market data (optional, for pricing) ────────────────────
# Developer keys from https://developer.tcgplayer.com/
TCGPLAYER_PUBLIC_KEY=
TCGPLAYER_PRIVATE_KEY=
# Optional: pre-issued access token (skips the token exchange).
TCGPLAYER_ACCESS_TOKEN=

# ── eBay market data (optional, for pricing) ─────────────────────────
# App credentials from https://developer.ebay.com/
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# ── Browser / Playwright ──────────────────────────────────────────────
# Override the Chrome binary path (default: system Chrome).
SCALPER_BROWSER_PATH=

# Local control dashboard. The server is restricted to loopback interfaces.
SCALPER_DASHBOARD_HOST=127.0.0.1
SCALPER_DASHBOARD_PORT=4317
# HTTP Basic/Bearer token. Required in live mode; browser access prompts for
# user "scalper" and this value as the password.
SCALPER_DASHBOARD_TOKEN=

# ── Data directory ────────────────────────────────────────────────────
# Where sessions, ledger, observations, and measurements are stored.
SCALPER_DATA_DIR=data/scalper
# Operator-measured poll URLs and response-field contracts imported into SQLite.
SCALPER_PRODUCT_ENDPOINTS_PATH=config/scalper-product-endpoints.json

# Paper-mode JSONL inbox for permitted/exported Discord message objects. The
# 24/7 service tails this file without automating a Discord user account.
SCALPER_SIGNAL_INBOX=1
SCALPER_SIGNAL_INBOX_PATH=data/scalper/inbox/discord.jsonl
# A live process ignores imported messages unless this separate acknowledgement
# is 1. Leave it unset throughout the seven-day paper burn-in.
SCALPER_SIGNAL_INBOX_LIVE_ACK=0

# Retail discovery creates durable simulated orders for new actionable
# transitions in paper mode. It never enables live execution.
SCALPER_DISCOVERY_PAPER=1
# Persistent discovery cadence. Five Best Buy searches run concurrently, and
# failures back off exponentially rather than increasing pressure on a site.
SCALPER_DISCOVERY_INTERVAL_MS=15000
SCALPER_DISCOVERY_MAX_BACKOFF_MS=300000

# Browser-observed public client key used by Target's search request. Keep the
# current value local because retailer client contracts can change or be
# revoked independently of this repository.
TARGET_PUBLIC_SEARCH_KEY=

# Operations log rotation (defaults: 5 MiB and five archives).
SCALPER_LOG_MAX_BYTES=5242880
SCALPER_LOG_ARCHIVES=5

# ── Accounts (referenced by config/scalper-accounts.json) ────────────
# Copy config/scalper-accounts.example.json to config/scalper-accounts.json.
# The example uses macOS Keychain references; configure them with
# `npm run scalper:secret -- set NAME`. Set this only for another local path.
SCALPER_ACCOUNTS_PATH=config/scalper-accounts.json
SCALPER_KEYCHAIN_SERVICE=com.local.pokemon-scalper
PC1_PASS=
PC1_CARD=
TCP1_PASS=
BB1_PASS=
TGT1_PASS=
