    "scalper:recipe": "node src/scalper/recipe-generator.mjs",
    "scalper:secret": "node src/scalper/vault-cli.mjs",
    "scalper:serve": "node src/scalper/serve.mjs",
    "scalper:install": "node src/scalper/install.mjs",
    "scalper:backup": "node src/scalper/backup.mjs",
    "scalper:release": "node src/scalper/release.mjs",
    "scalper:inventory": "node src/scalper/inventory-scanner.mjs",
    "scalper:watch": "node src/scalper/cli.mjs watch",
    "scalper:pc": "node src/scalper/cli.mjs pc",
    "scalper:tcp": "node src/scalper/cli.mjs tcp",
    "scalper:bb": "node src/scalper/cli.mjs bb",
    "scalper:tgt": "node src/scalper/cli.mjs tgt",
